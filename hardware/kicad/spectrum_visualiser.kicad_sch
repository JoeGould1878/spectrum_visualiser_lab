  (text "Preamp supply filter" (at 19.05 36.83 0) (effects (font (size 1.5 1.5) bold) (justify left)) (uuid 00adbc20-47d2-5af8-971b-2b92604919fd))
  (text "Board 3V3 -> R0/C0 -> +3V3_MIC (preamp only)." (at 19.05 77.47 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid aa75e8cb-ae43-5994-b062-4486cfe1202f))
  (text "Microphone preamp - LM358 (U1), one stage, gain ~x101" (at 68.58 36.83 0) (effects (font (size 1.5 1.5) bold) (justify left)) (uuid 4be37e05-b0ef-592e-9fa3-96e0e4ca560b))
  (text "Gain = 1 + R4/R5 = 101 (40 dB); C2 makes the DC gain 1." (at 68.58 110.49 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid f5f396fa-6abe-5b5c-9a1d-540badff3478))
  (text "Bias = +3V3_MIC x R3/(R2+R3) = 0.95 V.  R6 + C4: low-pass ~15 kHz." (at 68.58 113.03 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 827fc191-2b16-5b96-a57d-3a72b697ef0c))
  (text "On 3.3 V the LM358 output stays below ~1.8 V, so GPIO1 is safe." (at 68.58 115.57 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid acf25006-e46b-55c8-b1e9-7eb735e04f6c))
  (text "U1B unused: tied off" (at 119.38 102.87 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 48be7a3b-5ca0-532d-8630-286f12c8a775))
  (text "LED matrix - 4 x MAX7219, 32 x 8" (at 186.69 36.83 0) (effects (font (size 1.5 1.5) bold) (justify left)) (uuid 38d6f948-5e4d-52b7-857d-bd83ef4646fa))
  (text "U3-U6 (MAX7219 + 8x8 LEDs) are on the module." (at 186.69 71.12 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 210fff1c-d468-5d1a-a1d0-e7930f776a32))
  (text "Known limitation: its ~600 Hz row scan couples into" (at 186.69 73.66 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 4309962b-b19b-5c7b-bddd-9595d29d47c3))
  (text "the preamp through GND; run at brightness 0." (at 186.69 76.2 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 35ef402f-c218-5cdc-8e9d-dbd23eb146bf))
  (text "Buttons" (at 186.69 85.09 0) (effects (font (size 1.5 1.5) bold) (justify left)) (uuid 596f11bf-e72d-55ed-923e-5fdda6443fdd))
  (text "ESP32-S3 internal pull-ups; pressed = low." (at 186.69 110.49 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid f42b0a2c-d7af-577a-a7e9-5c0c15376849))
  (text "ESP32-S3 (U2) pin use" (at 19.05 87.63 0) (effects (font (size 1.5 1.5) bold) (justify left)) (uuid c44e1551-2d76-5c89-b9a5-3a9ccf9515d4))
