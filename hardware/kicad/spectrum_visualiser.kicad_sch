  (text "SW2 LISTEN" (at 48.26 132.715 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 4b7768c1-2a49-5224-ab95-5d7e3d7e10bb))
  (text "Global labels on this sheet = U2 pins." (at 19.05 140.97 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid de5a37fc-f5b1-5c67-b9af-99d9286e82f8))
  (text "Camera ribbon unplugged (Freenove board)." (at 19.05 143.51 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 9a0c486b-2359-5ecb-ae87-7a627e529249))
  (text "Notes" (at 68.58 128.27 0) (effects (font (size 1.5 1.5) bold) (justify left)) (uuid 4abc42f8-12ea-5243-9d3a-d83cf01fc8db))
  (text "1. All GND symbols are one net. Return the preamp GND and J1 GND to different U2 GND pins." (at 68.58 132.08 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid b56d75e0-189e-5660-b4f2-8dfebbba063b))
  (text "2. Electrolytics: C0 + to +3V3_MIC, C1 + to MK1, C2 + to R5. MK1 - is the pin joined to its case." (at 68.58 135.89000000000001 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid c151468d-9c7e-546e-b3a0-dd85c7aa1390))
  (text "3. DC check before wiring GPIO1: U1 pin 3 ~0.95 V, pin 1 ~0.9-1.1 V (quiet room)." (at 68.58 139.70000000000002 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 746f13ea-77de-52df-9bbe-83ca405dd66a))
  (text "4. Two-stage option (x1100): U1B becomes a x11 stage, see docs/diagrams/preamp-2.png." (at 68.58 143.51000000000002 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid e6303069-57b1-51d1-b238-e2b33ccc86c6))
  (text "5. +3V3_MIC is its own power net (project library spectrum.kicad_sym), not the board 3V3." (at 68.58 147.32000000000002 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid af3b4f55-3a25-5c77-ace9-930c6ff873e9))
